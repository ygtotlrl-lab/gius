<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- resolveActivity() for the tel: hand-off needs this on API 30+ -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="גיוס"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ⛔ אין כאן FileProvider (סבב 41) — הוא הועתק בשעתו מתבנית yoman
             יחד עם המעטפת, אבל ל-gius אין גשר שיתוף ואין קורא: נמדד ב-2026-08-19
             אפס `getUriForFile`, אפס `androidx` ואפס `navigator.share` בקוד.
             ההכרזה, `res/xml/file_paths.xml` ו-`androidx.core:core` הוסרו יחד
             באותו קומיט — הסרת אחד מהם בלבד שוברת את ה-APK בהתקנה. -->

    </application>
</manifest>
